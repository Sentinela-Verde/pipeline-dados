# Copie para .env e preencha. .env nunca deve ser commitado (ver .gitignore).

# ID do projeto Google Cloud usado por ee.Initialize(project=...) — etapa 2.
EE_PROJECT=

# Caminho ABSOLUTO para a chave de service account do Earth Engine, FORA deste repositório.
# Nunca coloque esse arquivo dentro da pasta do projeto.
# Opcional: sem ele, a etapa 2 cai no fluxo de login pelo navegador (ee.Authenticate()).
EE_SERVICE_ACCOUNT_KEY=

# Raiz do data lake. Padrão: a pasta `dados/` deste repositório.
DATA_ROOT=./dados

# Google Geocoding API (Maps Platform) — usada por
# projetos/01_coleta_datacenter/correcao_endereco/ pra padronizar endereço/município/estado/
# país/CEP a partir de lat/lon. Precisa da Geocoding API habilitada + faturamento ativo.
GOOGLE_MAPS_API_KEY=
